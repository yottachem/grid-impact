<title>Data Centers and Your Power Bill</title>
<style>
/* Layout: one reading column, set like a rate notice. Thesis, a statement box of headline figures, then three charts
   (each opened by a heavy rule, with numbered footnotes beneath), then notes. Tokens come from the site shell. */
.wrap { max-width: 980px; margin: 0 auto; padding-inline: 20px; padding-block: 28px 56px; display: grid; gap: 30px; }
header { display: grid; gap: 12px; }
.eyebrow { font: 500 11.5px/1.4 var(--font-data); letter-spacing: .07em; text-transform: uppercase; color: var(--muted);
  display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 16px; border-bottom: 1px dashed var(--line); padding-bottom: 8px; }
h1 { font: 400 clamp(32px, 4.8vw, 46px)/1.08 var(--font-display); letter-spacing: -.01em; margin: 0; text-wrap: balance; max-width: 22ch; }
.lede { margin: 0; font: 400 19px/1.5 var(--font-display); max-width: 64ch; }
.lede strong { font-weight: 600; }
.stamp { margin: 0; font-size: 13px; color: var(--muted); }
.figures { border: 1px solid var(--fg); background: var(--surface); max-width: 780px; }
.stmt-h { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 7px 14px; background: var(--tint); border-bottom: 1px solid var(--fg);
  font: 500 11px/1.4 var(--font-data); letter-spacing: .07em; text-transform: uppercase; }
.fig { display: grid; grid-template-columns: minmax(0, max-content) minmax(20px, 1fr) auto; align-items: end; gap: 10px; padding: 10px 14px; border-bottom: 1px dashed var(--line); }
.fig:last-child { border-bottom: 0; }
.fig::after { content: ""; grid-column: 2; grid-row: 1; border-bottom: 1px dotted var(--muted); margin-bottom: .4em; }
.fig-l { grid-column: 1; grid-row: 1; font-size: 14px; line-height: 1.4; max-width: 56ch; }
.fig-n { grid-column: 3; grid-row: 1; font: 500 17px/1.3 var(--font-data); font-variant-numeric: tabular-nums; white-space: nowrap; }
.stmt-h + .fig { background: var(--tint); }
.stmt-h + .fig .fig-n { color: var(--s1); font-weight: 600; font-size: 19px; }
.stmt-h + .fig .fig-l { font-weight: 600; }
section.chart { border-top: 2px solid var(--fg); padding-top: 14px; display: grid; gap: 10px; min-width: 0; }
h2 { font: 600 25px/1.2 var(--font-display); margin: 0; text-wrap: balance; }
.reading { margin: 0; max-width: 72ch; }
.legend { display: flex; flex-wrap: wrap; gap: 6px 18px; font: 12px/1.4 var(--font-data); color: var(--muted); }
.legend span { display: inline-flex; align-items: center; gap: 7px; }
.legend i { width: 14px; height: 12px; display: inline-block; }
.legend i.line { height: 0; width: 18px; border-top: 2.5px solid; }
.legend i.hatch { background: repeating-linear-gradient(135deg, var(--s1) 0 1.5px, transparent 1.5px 5px); border: 1px solid var(--s1); }
.plot { position: relative; width: 100%; }
.plot svg { display: block; width: 100%; height: auto; overflow: visible; }
.plot text { font: 11.5px var(--font-data); fill: var(--muted); }
.plot .lab { font: 500 12px var(--font-body); fill: var(--fg); }
.plot .lab.hi { font-weight: 600; }
.plot .fnm { font: 600 10.5px var(--font-data); fill: var(--s1); }
.tip { position: absolute; pointer-events: none; background: var(--surface); color: var(--fg); border: 1px solid var(--fg); padding: 7px 10px; font: 12px/1.45 var(--font-data); z-index: 2; min-width: 190px; }
.tip b { display: block; margin-bottom: 3px; font-weight: 600; }
.tip .row { display: flex; justify-content: space-between; gap: 14px; font-variant-numeric: tabular-nums; }
.tip .k { color: var(--muted); display: inline-flex; align-items: center; gap: 6px; }
.tip i { width: 9px; height: 9px; display: inline-block; }
.fnotes { margin: 0; padding: 0; list-style: none; display: grid; gap: 4px; font: 12px/1.45 var(--font-data); max-width: 86ch; }
.fnotes li { display: grid; grid-template-columns: 22px 1fr; }
.fnotes b { color: var(--s1); }
.note { font-size: 13px; color: var(--muted); margin: 0; max-width: 78ch; }
.notes { display: grid; gap: 8px; font-size: 13px; color: var(--muted); max-width: 78ch; border-top: 1px dashed var(--line); padding-top: 14px; }
.notes p { margin: 0; }
.notes a, .lede a { color: inherit; }
.notes strong { color: var(--fg); font-weight: 600; }
.review { display: inline-block; font: 500 11px/1.5 var(--font-data); letter-spacing: .04em; text-transform: uppercase; color: var(--s2); border: 1px solid currentColor; padding: 0 5px; margin-left: 4px; vertical-align: 1px; cursor: help; }
.banner { margin: 0; padding: 10px 14px; border: 1px solid var(--s2); background: var(--surface); font-size: 14px; max-width: 78ch; }
.feedback { font-size: 13px; color: var(--muted); margin: 0; }
.feedback a { color: var(--s1); }
sup.fn { font: 500 10px/0 var(--font-data); margin-left: 1px; } sup.fn a { color: var(--s1); text-decoration: none; }
@media (max-width: 620px) {
  .fig { grid-template-columns: minmax(0, 1fr) auto; }
  .fig::after { display: none; }
  .fig-n { grid-column: 2; }
  .lede { font-size: 17.5px; }
}
</style>

<div class="wrap">
  <header>
    <div class="eyebrow"><span>Grid Impact Tracker · Findings</span><span id="asof"></span></div>
    <h1 id="headline">{{plain:headline}}</h1>
    <p class="lede">{{claim:lede_intro}} {{claim:lede_local}} {{claim:lede_regional}}</p>
    <p class="stamp" id="stamp"></p>
  </header>
  {{review_banner}}

  <section class="figures" aria-label="Headline figures"><div class="stmt-h"><span>Summary of findings</span><span>Updated with each data release</span></div>{{figure:fig1}}{{figure:fig2}}{{figure:fig3}}{{figure:fig4}}</section>

  <section class="chart" aria-labelledby="c1h">
    <h2 id="c1h">Capacity cost per household: PJM, New England, MISO, and New York</h2>
    <p class="reading" id="c1r">{{claim:c1_reading}} {{claim:c1_compare}} {{claim:c1_miso}} {{claim:c1_ny}}</p>
    <div class="legend"><span><i class="line" style="border-color:var(--s1)"></i>PJM, typical home on default supply (central estimate)</span><span><i style="background:var(--band)"></i>Range (peak factor 1.0 to 1.4)</span><span><i class="hatch"></i>Portion attributed to data center load</span><span><i class="line" style="border-color:var(--g2)"></i>Other markets, same method</span></div>
    <div class="plot" id="c1"></div>
    <ol class="fnotes" id="c1n"></ol>
    <p class="note">{{claim:c1_note}}</p>
  </section>

  <section class="chart" aria-labelledby="c2h">
    <h2 id="c2h">PJM residential prices vs. the rest of the US</h2>
    <p class="reading" id="c2r">{{claim:c2_reading}}</p>
    <div class="legend"><span><i class="line" style="border-color:var(--s1)"></i>PJM difference, inflation-adjusted, relative to 2020</span><span><i style="background:var(--band)"></i>95% confidence interval</span></div>
    <div class="plot" id="c2"></div>
    <ol class="fnotes" id="c2n"></ol>
    <p class="note">{{claim:c2_note}}</p>
  </section>

  <section class="chart" aria-labelledby="c3h">
    <h2 id="c3h">Four markets, one data center boom, different bills</h2>
    <p class="reading" id="c3r">{{claim:c3_reading}}</p>
    <div class="legend" id="c3legend"></div>
    <div class="plot" id="c3"></div>
    <p class="note">{{claim:c3_note}}</p>
  </section>

  <section class="notes">
    <p>{{claim:local_note}} {{claim:local_benchmark}}</p>
    <p id="relpara">{{claim:rel_utility}} {{claim:rel_county}} {{claim:rel_supply}}</p>
    <p>{{claim:caveat_timing}} {{claim:caveat_upper_bound}} {{claim:caveat_coverage}} {{claim:caveat_dominion}}</p>
    <p class="feedback">Every statement on this page is checked against the data each time the analysis runs; one that no longer fits is marked for review. See an error, or disagree with a conclusion? <a href="{{feedback_url}}">Report an issue</a>.</p>
    <p id="built"></p>
    <p>Sources: EIA-861M, EIA-930, EIA-860M; PJM Base Residual Auction reports; Monitoring Analytics (PJM Independent Market Monitor); BLS CPI; NOAA nClimDiv; Census ACS. Data center locations: FracTracker Alliance, PNNL IM3, OpenStreetMap contributors, PeeringDB. Code and methods: github.com/yottachem/grid-impact.</p>
  </section>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.9.0/d3.min.js"></script>
<script>
const D = __DATA__;
const css = n => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
const usd = v => "$" + Math.round(v).toLocaleString();
const pct = v => (v > 0 ? "+" : v < 0 ? "−" : "") + Math.abs(v).toFixed(1) + "%";

const cap = D.capacity, es = D.event_pjm, esLast = es[es.length - 1], capLast = cap[cap.length - 1];
const s3 = D.cases, Y = D.ytd_year;
const mon = s => new Date(s + "-01T12:00:00").toLocaleString("en-US", { month: "long", year: "numeric" });
if (D.run.ran_at) document.getElementById("stamp").textContent = `Analysis updated ${new Date(D.run.ran_at).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}, with residential prices through ${mon(D.run.prices_through)}. PJM auction results through ${D.run.capacity_auctions_through}. See Data status for each source.`;
document.getElementById("asof").textContent = `Prices through ${mon(D.run.prices_through || D.price_through)}`;
document.getElementById("built").textContent = `Draft built ${D.built}. Prices through ${D.price_through}.`;

// Shared tooltip
function tooltip(host) {
  const t = document.createElement("div"); t.className = "tip"; t.hidden = true; host.appendChild(t);
  return {
    show(html, e) {
      t.innerHTML = html; t.hidden = false;
      const b = host.getBoundingClientRect(); let x = e.clientX - b.left + 12, y = e.clientY - b.top + 12;
      if (x + t.offsetWidth > b.width) x = e.clientX - b.left - t.offsetWidth - 12;
      if (y + t.offsetHeight > b.height) y = Math.max(0, e.clientY - b.top - t.offsetHeight - 12);
      t.style.left = Math.max(0, x) + "px"; t.style.top = y + "px";
    },
    hide() { t.hidden = true; },
  };
}
const row = (k, v, c) => `<div class="row"><span class="k">${c ? `<i style="background:${c}"></i>` : ""}${k}</span><span>${v}</span></div>`;

// Numbered chart footnotes: a circled number on the chart, the note in a list beneath it
function footnote(svg, n, px, py) {
  svg.append("circle").attr("cx", px).attr("cy", py).attr("r", 7.5).style("fill", "var(--surface)").style("stroke", "var(--s1)").style("stroke-width", "1.2px");
  svg.append("text").attr("class", "fnm").attr("x", px).attr("y", py + 3.5).attr("text-anchor", "middle").text(n);
}
const LETTER = i => "abcdefgh"[i];  // letters, so chart notes never collide with numbered source footnotes
const notes = (id, items) => { document.getElementById(id).innerHTML = items.map((t, i) => `<li><b>${LETTER(i)}</b><span>${t}</span></li>`).join(""); };
// Right-margin labels with dotted leaders back to each series' last point
function endLabels(svg, ends, xLab) {
  ends.sort((a, b) => a.y - b.y);
  for (let i = 1; i < ends.length; i++) if (ends[i].y - ends[i - 1].y < 15) ends[i].y = ends[i - 1].y + 15;
  ends.forEach(e => {
    if (xLab - e.x > 10) svg.append("line").attr("x1", e.x + 3).attr("x2", xLab - 4).attr("y1", e.y0).attr("y2", e.y)
      .style("stroke", "var(--muted)").style("stroke-width", "1px").style("stroke-dasharray", "1 3");
    svg.append("text").attr("class", e.hi ? "lab hi" : "lab").attr("x", xLab).attr("y", e.y + 4).text(e.text);
  });
}

// Chart 1: capacity cost per home, stepped by delivery year. PJM highlighted with its range and data center portion.
function chart1() {
  const host = document.getElementById("c1"); host.innerHTML = "";
  const W = 900, H = 330, m = { t: 22, r: 150, b: 34, l: 48 };
  const svg = d3.select(host).append("svg").attr("viewBox", `0 0 ${W} ${H}`).attr("role", "img")
    .attr("aria-label", "Step chart of capacity cost per household by delivery year: PJM highlighted, New England, MISO, and New York in gray");
  const x = d3.scaleBand().domain(cap.map(d => d.dy)).range([m.l, W - m.r]).padding(0);
  const others = [
    { key: "ne", name: "New England", data: D.capacity_ne || [], tok: "--g1", dash: null },
    { key: "mi", name: "MISO (Ameren IL)", data: D.capacity_miso || [], tok: "--g2", dash: "6 3" },
    { key: "ny", name: "New York", data: D.capacity_ny || [], tok: "--g1", dash: "1.5 3" },
  ].map(o => ({ ...o, data: o.data.filter(d => x(d.dy) != null) }));
  const y = d3.scaleLinear().domain([0, Math.max(300, d3.max(cap, d => d.high) * 1.08, ...others.map(o => (d3.max(o.data, d => d.central) || 0) * 1.08))]).nice().range([H - m.b, m.t]);
  const x0 = d => x(d.dy), x1 = d => x(d.dy) + x.bandwidth();
  const step = (data, v) => data.map((d, i) => (i ? `V${y(v(d))}` : `M${x0(d)},${y(v(d))}`) + `H${x1(d)}`).join("");
  const stepBand = (data, lo, hi) => step(data, hi) + [...data].reverse().map(d => `V${y(lo(d))}H${x0(d)}`).join("") + "Z";
  svg.append("defs").append("pattern").attr("id", "hatch").attr("patternUnits", "userSpaceOnUse").attr("width", 6).attr("height", 6)
    .attr("patternTransform", "rotate(45)").append("rect").attr("width", 1.6).attr("height", 6).style("fill", "var(--s1)");
  svg.append("g").selectAll("line").data(y.ticks(6)).join("line")
    .attr("x1", m.l).attr("x2", W - m.r).attr("y1", d => y(d)).attr("y2", d => y(d)).style("stroke", d => d ? "var(--grid)" : "var(--fg)");
  svg.append("g").selectAll("text").data(y.ticks(6)).join("text")
    .attr("x", m.l - 8).attr("y", d => y(d) + 4).attr("text-anchor", "end").text(d => "$" + d);
  svg.append("g").selectAll("text").data(cap).join("text")
    .attr("x", d => x0(d) + x.bandwidth() / 2).attr("y", H - 12).attr("text-anchor", "middle").text(d => d.dy.slice(2));
  svg.append("path").attr("d", stepBand(cap, d => d.low, d => d.high)).style("fill", "var(--band)");
  const dcRows = cap.filter(d => d.dc != null);
  dcRows.forEach(d => svg.append("rect").attr("x", x0(d)).attr("width", x.bandwidth()).attr("y", y(d.dc)).attr("height", y(0) - y(d.dc))
    .style("fill", "url(#hatch)").style("stroke", "var(--s1)").style("stroke-width", ".8px"));
  const ends = [];
  others.forEach(o => {
    if (!o.data.length) return;
    svg.append("path").attr("d", step(o.data, d => d.central)).style("fill", "none").style("stroke", `var(${o.tok})`)
      .style("stroke-width", "1.6px").style("stroke-dasharray", o.dash);
    const e = o.data[o.data.length - 1];
    ends.push({ x: x1(e), y0: y(e.central), y: y(e.central), text: `${o.name} ${usd(e.central)}` });
  });
  svg.append("path").attr("d", step(cap, d => d.central)).style("fill", "none").style("stroke", "var(--s1)").style("stroke-width", "2.8px");
  ends.push({ x: x1(capLast), y0: y(capLast.central), y: y(capLast.central), text: `PJM ${usd(capLast.central)}`, hi: true });
  endLabels(svg, ends, W - m.r + 12);
  // Footnotes from the data: PJM's largest one-year jump, and the highest MISO year
  const fn = [];
  let jump = null;
  cap.forEach((d, i) => { if (i && (!jump || d.central - cap[i - 1].central > jump.d.central - jump.p.central)) jump = { d, p: cap[i - 1] }; });
  if (jump) {
    footnote(svg, LETTER(fn.length), x0(jump.d) - 9, y(jump.d.high) - 12);
    fn.push(`${jump.d.dy}: PJM's auction price rose from $${jump.p.price.toFixed(2)} to $${jump.d.price.toFixed(2)} per MW-day, and the typical home's capacity cost from ${usd(jump.p.central)} to ${usd(jump.d.central)} a year.`);
  }
  const mi = others.find(o => o.key === "mi").data;
  if (mi.length) {
    const top = mi.reduce((a, b) => (b.central > a.central ? b : a));
    footnote(svg, LETTER(fn.length), x0(top) + x.bandwidth() / 2, y(top.central) - 14);
    fn.push(`${top.dy}: MISO's auction cleared at $${top.price.toFixed(2)} per MW-day in Ameren Illinois' zone, ${usd(top.central)} for a typical home that year.`);
  }
  notes("c1n", fn);
  const by = Object.fromEntries(others.map(o => [o.key, new Map(o.data.map(d => [d.dy, d]))]));
  const tip = tooltip(host);
  svg.append("g").selectAll("rect").data(cap).join("rect").attr("x", x0).attr("width", x.bandwidth()).attr("y", m.t).attr("height", H - m.t - m.b)
    .style("fill", "transparent")
    .on("pointermove", (e, d) => tip.show(`<b>Delivery year ${d.dy}</b>${row("PJM cost per home", usd(d.central), css("--s1"))}${row("Range", `${usd(d.low)} to ${usd(d.high)}`)}${row("Data center portion", d.dc != null ? usd(d.dc) : "not published")}${row("PJM auction price", "$" + d.price.toFixed(2) + "/MW-day")}${others.map(o => by[o.key].has(d.dy) ? row(o.name, usd(by[o.key].get(d.dy).central), css(o.tok)) : "").join("")}`, e))
    .on("pointerleave", () => tip.hide());
}

// Chart 2: PJM event study
function chart2() {
  const host = document.getElementById("c2"); host.innerHTML = "";
  const W = 900, H = 300, m = { t: 22, r: 16, b: 34, l: 48 };
  const data = [...es, { year: 2020, pct: 0, ci_low: 0, ci_high: 0, ref: true }].sort((a, b) => a.year - b.year);
  const svg = d3.select(host).append("svg").attr("viewBox", `0 0 ${W} ${H}`).attr("role", "img")
    .attr("aria-label", "Line chart of the PJM residential price difference vs rest of US by year");
  const x = d3.scaleLinear().domain(d3.extent(data, d => d.year)).range([m.l, W - m.r]);
  const y = d3.scaleLinear().domain([Math.min(-5, d3.min(data, d => d.ci_low)), Math.max(25, d3.max(data, d => d.ci_high))]).nice().range([H - m.b, m.t]);
  svg.append("g").selectAll("line").data(y.ticks(6)).join("line")
    .attr("x1", m.l).attr("x2", W - m.r).attr("y1", d => y(d)).attr("y2", d => y(d))
    .style("stroke", d => d === 0 ? "var(--fg)" : "var(--grid)");
  svg.append("g").selectAll("text").data(y.ticks(6)).join("text")
    .attr("x", m.l - 8).attr("y", d => y(d) + 4).attr("text-anchor", "end").text(d => (d > 0 ? "+" : "") + d + "%");
  svg.append("g").selectAll("text").data(data).join("text")
    .attr("x", d => x(d.year)).attr("y", H - 12).attr("text-anchor", "middle").text(d => d.year);
  svg.append("path").datum(data).attr("d", d3.area().x(d => x(d.year)).y0(d => y(d.ci_low)).y1(d => y(d.ci_high)))
    .style("fill", "var(--band)");
  svg.append("path").datum(data).attr("d", d3.line().x(d => x(d.year)).y(d => y(d.pct)))
    .style("fill", "none").style("stroke", "var(--s1)").style("stroke-width", "2.5px");
  svg.append("g").selectAll("circle").data(data).join("circle")
    .attr("cx", d => x(d.year)).attr("cy", d => y(d.pct)).attr("r", 4)
    .style("fill", d => d.ref ? "var(--surface)" : "var(--s1)").style("stroke", d => d.ref ? "var(--s1)" : "var(--surface)").style("stroke-width", "2px");
  const xa = x(2025 + 5 / 12);
  svg.append("line").attr("x1", xa).attr("x2", xa).attr("y1", m.t).attr("y2", H - m.b).style("stroke", "var(--muted)").style("stroke-dasharray", "3 3");
  footnote(svg, "a", xa, m.t - 8);
  notes("c2n", ["June 2025: the 2025/26 capacity price, the jump in the chart above, starts reaching PJM bills. The reference year is 2020."]);
  svg.append("text").attr("class", "lab hi").attr("x", x(esLast.year) - 6).attr("y", y(esLast.pct) - 10).attr("text-anchor", "end").text(pct(esLast.pct));
  const tip = tooltip(host);
  const cross = svg.append("line").attr("y1", m.t).attr("y2", H - m.b).style("stroke", "var(--muted)").style("opacity", 0);
  svg.append("rect").attr("x", m.l).attr("y", m.t).attr("width", W - m.l - m.r).attr("height", H - m.t - m.b).style("fill", "transparent")
    .on("pointermove", function (e) {
      const [px] = d3.pointer(e, this); const yr = Math.round(x.invert(px)); const d = data.find(v => v.year === yr); if (!d) return;
      cross.attr("x1", x(yr)).attr("x2", x(yr)).style("opacity", 1);
      tip.show(d.ref ? `<b>${yr}</b>${row("Reference year", "0%")}` : `<b>${yr}</b>${row("PJM vs rest of US", pct(d.pct), css("--s1"))}${row("95% CI", `${pct(d.ci_low)} to ${pct(d.ci_high)}`)}`, e);
    })
    .on("pointerleave", () => { tip.hide(); cross.style("opacity", 0); });
}

// Chart 3: case study indices. Dominion (the data center hub) highlighted, the others gray.
function chart3() {
  const host = document.getElementById("c3"); host.innerHTML = "";
  const names = ["Dominion Energy Virginia", "Baltimore Gas & Electric", "Texas statewide", "Georgia Power"];
  const tok = ["--s1", "--g1", "--g2", "--g3"];
  document.getElementById("c3legend").innerHTML = `<span><i class="line" style="border-color:var(--s1)"></i>Dominion Energy Virginia</span><span><i class="line" style="border-color:var(--g2)"></i>Comparison utilities (labeled)</span><span><i class="line" style="border-color:var(--muted);border-top-style:dashed"></i>${Y}: same months vs ${Y - 1}</span>`;
  const W = 900, H = 320, m = { t: 14, r: 150, b: 34, l: 48 };
  const svg = d3.select(host).append("svg").attr("viewBox", `0 0 ${W} ${H}`).attr("role", "img")
    .attr("aria-label", "Line chart of inflation-adjusted residential price index, 2019 = 100, for four utilities");
  const all = names.flatMap(n => s3[n].map(d => d.idx));
  const x = d3.scaleLinear().domain([2019, Y]).range([m.l, W - m.r]);
  const y = d3.scaleLinear().domain([Math.min(85, d3.min(all) - 5), Math.max(140, d3.max(all) + 5)]).nice().range([H - m.b, m.t]);
  svg.append("g").selectAll("line").data(y.ticks(6)).join("line")
    .attr("x1", m.l).attr("x2", W - m.r).attr("y1", d => y(d)).attr("y2", d => y(d))
    .style("stroke", d => d === 100 ? "var(--fg)" : "var(--grid)");
  svg.append("g").selectAll("text").data(y.ticks(6)).join("text")
    .attr("x", m.l - 8).attr("y", d => y(d) + 4).attr("text-anchor", "end").text(d => d);
  svg.append("g").selectAll("text").data(d3.range(2019, Y + 1)).join("text")
    .attr("x", d => x(d)).attr("y", H - 12).attr("text-anchor", "middle").text(d => d === Y ? `${Y} YTD` : d);
  const line = d3.line().x(d => x(d.year)).y(d => y(d.idx));
  const ends = [];
  [...names].reverse().forEach(n => {
    const i = names.indexOf(n), s = s3[n], full = s.filter(d => !d.ytd), tail = s.slice(-2), w = i ? "1.6px" : "2.8px";
    svg.append("path").datum(full).attr("d", line).style("fill", "none").style("stroke", `var(${tok[i]})`).style("stroke-width", w);
    svg.append("path").datum(tail).attr("d", line).style("fill", "none").style("stroke", `var(${tok[i]})`).style("stroke-width", w).style("stroke-dasharray", "4 4");
    const e = s[s.length - 1];
    svg.append("circle").attr("cx", x(e.year)).attr("cy", y(e.idx)).attr("r", i ? 3 : 4).style("fill", `var(${tok[i]})`).style("stroke", "var(--surface)").style("stroke-width", "2px");
    ends.push({ x: x(e.year), y0: y(e.idx), y: y(e.idx), hi: !i, text: `${n.replace("Baltimore Gas & Electric", "BGE").replace("Dominion Energy Virginia", "Dominion")} ${Math.round(e.idx)}` });
  });
  endLabels(svg, ends, x(Y) + 10);
  const tip = tooltip(host);
  const cross = svg.append("line").attr("y1", m.t).attr("y2", H - m.b).style("stroke", "var(--muted)").style("opacity", 0);
  svg.append("rect").attr("x", m.l).attr("y", m.t).attr("width", x(Y) - m.l + 6).attr("height", H - m.t - m.b).style("fill", "transparent")
    .on("pointermove", function (e) {
      const [px] = d3.pointer(e, this); const yr = Math.max(2019, Math.min(Y, Math.round(x.invert(px))));
      cross.attr("x1", x(yr)).attr("x2", x(yr)).style("opacity", 1);
      const rows = names.map((n, i) => { const d = s3[n].find(v => v.year === yr); return d ? row(n, `${d.idx.toFixed(1)} · ${d.cents.toFixed(1)}¢`, css(tok[i])) : ""; }).join("");
      tip.show(`<b>${yr === Y ? `${Y} (${D.ytd_months} vs ${Y - 1})` : yr}</b>${rows}`, e);
    })
    .on("pointerleave", () => { tip.hide(); cross.style("opacity", 0); });
}

function drawAll() { chart1(); chart2(); chart3(); }
drawAll();
matchMedia("(prefers-color-scheme: dark)").addEventListener("change", drawAll);
new MutationObserver(drawAll).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
</script>

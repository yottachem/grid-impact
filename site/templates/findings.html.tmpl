<title>Data Centers and Your Power Bill</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:wght@500;600&family=Public+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style>
/* Layout: one reading column. Thesis, four headline figures, then three charts, each with a one-paragraph reading. Same identity as the data center map. */
:root {
  --bg: #f5f7f9; --surface: #ffffff; --fg: #11161d; --muted: #586271; --line: #d8dee6; --grid: #e8ecf1;
  --s1: #2a78d6; --s2: #eb6834; --s3: #1baf7a; --s4: #eda100; --band: rgba(42,120,214,.16);
  --font-display: "Barlow Semi Condensed", "Arial Narrow", "Helvetica Neue", Arial, sans-serif;
  --font-body: "Public Sans", "Helvetica Neue", Arial, sans-serif;
  --font-data: "IBM Plex Mono", ui-monospace, "SF Mono", Menlo, monospace;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #11151a; --surface: #181d23; --fg: #eef1f4; --muted: #9aa5b2; --line: #2b323b; --grid: #232a32;
    --s1: #3987e5; --s2: #d95926; --s3: #199e70; --s4: #c98500; --band: rgba(57,135,229,.22);
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #11151a; --surface: #181d23; --fg: #eef1f4; --muted: #9aa5b2; --line: #2b323b; --grid: #232a32;
  --s1: #3987e5; --s2: #d95926; --s3: #199e70; --s4: #c98500; --band: rgba(57,135,229,.22);
  color-scheme: dark;
}
* { box-sizing: border-box; }
body { background: var(--bg); color: var(--fg); font: 15px/1.55 var(--font-body); }
.wrap { max-width: 980px; margin: 0 auto; padding-inline: 20px; padding-block: 32px 56px; display: grid; gap: 28px; }
header { display: grid; gap: 8px; }
.eyebrow { font: 500 12px/1 var(--font-data); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
h1 { font: 600 clamp(30px, 4.6vw, 44px)/1.04 var(--font-display); margin: 0; text-wrap: balance; max-width: 22ch; }
.lede { margin: 0; color: var(--muted); max-width: 68ch; }
.lede strong { color: var(--fg); font-weight: 600; }
.figures { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
.fig { background: var(--surface); border: 1px solid var(--line); border-radius: 6px; padding: 14px; display: grid; gap: 6px; align-content: start; min-width: 0; }
.fig-n { font: 600 30px/1 var(--font-display); font-variant-numeric: tabular-nums; }
.fig-l { font-size: 13px; line-height: 1.4; color: var(--muted); }
section.chart { background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 18px 18px 14px; display: grid; gap: 10px; min-width: 0; }
h2 { font: 600 23px/1.15 var(--font-display); margin: 0; text-wrap: balance; }
.reading { margin: 0; max-width: 72ch; }
.legend { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 13px; color: var(--muted); }
.legend span { display: inline-flex; align-items: center; gap: 6px; }
.legend i { width: 12px; height: 12px; border-radius: 3px; display: inline-block; }
.legend i.line { height: 3px; border-radius: 2px; width: 16px; }
.plot { position: relative; width: 100%; }
.plot svg { display: block; width: 100%; height: auto; overflow: visible; }
.plot text { font: 12px var(--font-data); fill: var(--muted); }
.plot .lab { font: 500 12px var(--font-body); fill: var(--fg); }
.tip { position: absolute; pointer-events: none; background: var(--surface); color: var(--fg); border: 1px solid var(--line); border-radius: 6px; padding: 8px 10px; font-size: 13px; line-height: 1.4; box-shadow: 0 6px 20px rgba(0,0,0,.14); z-index: 2; min-width: 170px; }
.tip b { display: block; margin-bottom: 2px; }
.tip .row { display: flex; justify-content: space-between; gap: 12px; font-variant-numeric: tabular-nums; }
.tip .k { color: var(--muted); display: inline-flex; align-items: center; gap: 6px; }
.tip i { width: 9px; height: 9px; border-radius: 50%; display: inline-block; }
.note { font-size: 13px; color: var(--muted); margin: 0; max-width: 78ch; }
.notes { display: grid; gap: 8px; font-size: 13px; color: var(--muted); max-width: 78ch; }
.notes p { margin: 0; }
.notes a, .lede a { color: inherit; }
@media (max-width: 760px) { .figures { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>

<div class="wrap">
  <header>
    <div class="eyebrow">Grid Impact Tracker · findings draft</div>
    <h1>Data centers raise power bills through the regional market, not the utility next door</h1>
    <p class="lede">Across __NUNITS__ US utility service areas from 2015 to July 2026, a utility's own data center load has not pushed up its residential prices relative to neighbors in the same market. The cost shows up regionally: in PJM, the 13-state grid with the most data center growth, a capacity shortfall driven largely by forecast data center demand now costs a typical household in a restructured state <strong>about $190 a year more</strong> than in 2024/25.</p>
  </header>

  <section class="figures" aria-label="Headline figures" id="figures"></section>

  <section class="chart" aria-labelledby="c1h">
    <h2 id="c1h">Capacity cost per household in restructured PJM states</h2>
    <p class="reading" id="c1r"></p>
    <div class="legend"><span><i style="background:var(--s1)"></i>Capacity cost per home per year (central estimate)</span><span><i style="background:var(--s2)"></i>Portion attributed to data center load</span><span><i class="line" style="background:var(--muted)"></i>Range (peak factor 1.0 to 1.4)</span></div>
    <div class="plot" id="c1"></div>
    <p class="note">Median across 24 utilities in IL, NJ, PA, OH, MD, DE, and DC whose default supply passes auction prices through. Auction totals from PJM Base Residual Auction reports; data center attribution from PJM's Independent Market Monitor ($9.3B of 2025/26; $23.1B across 2025/26 to 2027/28; none published yet for 2028/29). Delivery years run June to May.</p>
  </section>

  <section class="chart" aria-labelledby="c2h">
    <h2 id="c2h">PJM residential prices vs. the rest of the US</h2>
    <p class="reading" id="c2r"></p>
    <div class="legend"><span><i class="line" style="background:var(--s1)"></i>PJM difference, inflation-adjusted, relative to 2020</span><span><i style="background:var(--band)"></i>95% confidence interval</span></div>
    <div class="plot" id="c2"></div>
    <p class="note">Regression on utility-month residential prices with utility and month fixed effects and weather controls; standard errors clustered by utility. 2026 covers January to July.</p>
  </section>

  <section class="chart" aria-labelledby="c3h">
    <h2 id="c3h">Four markets, one data center boom, different bills</h2>
    <p class="reading" id="c3r"></p>
    <div class="legend" id="c3legend"></div>
    <div class="plot" id="c3"></div>
    <p class="note">Residential price after inflation (Census-region CPI), indexed to 2019 = 100. The 2026 point (dashed) applies the January to July change vs. the same months of 2025, so seasonal rates don't distort it. Texas is the statewide total, which includes some areas outside ERCOT.</p>
  </section>

  <section class="notes">
    <p><b style="color:var(--fg)">What doesn't explain it.</b> Comparing each utility with others in its own regional market and month, a 40% rise in its own commercial load goes with a <span id="elast"></span> change in residential price. More sales spread fixed costs. The burden comes from regional supply shortfalls and how each market passes them through.</p>
    <p><b style="color:var(--fg)">Caveats.</b> The PJM premium began in 2023, before capacity prices spiked, which is consistent with 2022 gas prices being locked into default-service supply contracts; capacity costs explain its widening in 2025 and 2026. Auction totals are cleared MW times price, which PJM notes overstates cost to load because some load is hedged or self-supplied, so household figures are upper-bound averages. Dominion's 2026 increase also includes an approved base-rate increase of $11.24 a month.</p>
    <p id="built"></p>
    <p>Sources: EIA-861M, EIA-930, EIA-860M; PJM Base Residual Auction reports; Monitoring Analytics (PJM Independent Market Monitor); BLS CPI; NOAA nClimDiv; Census ACS. Data center locations: FracTracker Alliance, PNNL IM3, OpenStreetMap contributors, PeeringDB. Code and methods: github.com/yottachem/grid-impact.</p>
  </section>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.9.0/d3.min.js"></script>
<script>
const D = __DATA__;
const css = n => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
const usd = v => "$" + Math.round(v).toLocaleString();
const pct = v => (v > 0 ? "+" : v < 0 ? "−" : "") + Math.abs(v).toFixed(1) + "%";

// Headline figures
const cap = D.capacity, last = cap.find(d => d.dy === "2027/28"), base = cap.find(d => d.dy === "2024/25");
const es = D.event_pjm, es26 = es.find(d => d.year === 2026);
const figs = [
  [usd(last.central - base.central), "more per year for capacity in 2027/28 than 2024/25, typical restructured-PJM home"],
  [usd(cap.find(d => d.dy === "2026/27").dc), "of the 2026/27 cost per home attributed to data center load"],
  [pct(es26.pct), "PJM residential price vs. rest of US in 2026, after inflation (2020 baseline)"],
  [pct(D.local40.pct), "residential price change with 40% more local commercial load, vs. regional peers"],
];
document.getElementById("figures").innerHTML = figs.map(([n, l]) => `<div class="fig"><span class="fig-n">${n}</span><span class="fig-l">${l}</span></div>`).join("");
document.getElementById("elast").textContent = `${pct(D.local40.pct)} (95% CI ${pct(D.local40.lo)} to ${pct(D.local40.hi)})`;
document.getElementById("c1r").textContent = `Capacity costs for a typical home fell to ${usd(cap.find(d => d.dy === "2023/24").central)} a year in 2023/24, then jumped to ${usd(cap.find(d => d.dy === "2025/26").central)} when the 2025/26 auction cleared at $269.92 per MW-day, and reached ${usd(last.central)} as the next three auctions cleared at their price caps. That is the highest level in the record, about 1.5 times 2018/19. The market monitor attributes roughly ${usd(cap.find(d => d.dy === "2026/27").dc)} to ${usd(cap.find(d => d.dy === "2025/26").dc)} a year of it to data center load.`;
document.getElementById("c2r").textContent = `PJM prices tracked the rest of the country through 2021. The gap opened in 2023 (${pct(es.find(d => d.year === 2023).pct)}) and widened to ${pct(es26.pct)} in 2026 as capacity costs reached bills. The confidence band excludes zero from 2022 on.`;
const s3 = D.cases, endOf = n => s3[n][s3[n].length - 1];
document.getElementById("c3r").textContent = `Baltimore Gas & Electric's customers, in a PJM state with few large data centers of its own, saw real prices rise ${(endOf("Baltimore Gas & Electric").idx - 100).toFixed(0)}% from 2019. Dominion's prices fell in real terms until its first year inside the PJM capacity auction, then jumped. Texas, an energy-only market building 88 GW of new generation, and Georgia Power, which has frozen base rates, stayed near 2019 levels.`;
document.getElementById("built").textContent = `Draft built ${D.built}. Prices through ${D.price_through}.`;

// Shared tooltip
function tooltip(host) {
  const t = document.createElement("div"); t.className = "tip"; t.hidden = true; host.appendChild(t);
  return {
    show(html, e) {
      t.innerHTML = html; t.hidden = false;
      const b = host.getBoundingClientRect(); let x = e.clientX - b.left + 12, y = e.clientY - b.top + 12;
      if (x + t.offsetWidth > b.width) x = e.clientX - b.left - t.offsetWidth - 12;
      if (y + t.offsetHeight > b.height) y = Math.max(0, e.clientY - b.top - t.offsetHeight - 12);
      t.style.left = Math.max(0, x) + "px"; t.style.top = y + "px";
    },
    hide() { t.hidden = true; },
  };
}
const row = (k, v, c) => `<div class="row"><span class="k">${c ? `<i style="background:${c}"></i>` : ""}${k}</span><span>${v}</span></div>`;

// Chart 1: capacity cost columns
function chart1() {
  const host = document.getElementById("c1"); host.innerHTML = "";
  const W = 900, H = 320, m = { t: 14, r: 10, b: 34, l: 48 };
  const svg = d3.select(host).append("svg").attr("viewBox", `0 0 ${W} ${H}`).attr("role", "img")
    .attr("aria-label", "Column chart of capacity cost per household by delivery year");
  const x = d3.scaleBand().domain(cap.map(d => d.dy)).range([m.l, W - m.r]).padding(0.28);
  const y = d3.scaleLinear().domain([0, 300]).range([H - m.b, m.t]);
  svg.append("g").selectAll("line").data(y.ticks(6)).join("line")
    .attr("x1", m.l).attr("x2", W - m.r).attr("y1", d => y(d)).attr("y2", d => y(d)).style("stroke", "var(--grid)");
  svg.append("g").selectAll("text").data(y.ticks(6)).join("text")
    .attr("x", m.l - 8).attr("y", d => y(d) + 4).attr("text-anchor", "end").text(d => "$" + d);
  svg.append("g").selectAll("text").data(cap).join("text")
    .attr("x", d => x(d.dy) + x.bandwidth() / 2).attr("y", H - 12).attr("text-anchor", "middle").text(d => d.dy);
  const bw = x.bandwidth(), r = 4;
  const colPath = (x0, y0, w, h) => h <= 0 ? "" : `M${x0},${y0 + h}V${y0 + Math.min(r, h)}Q${x0},${y0} ${x0 + Math.min(r, w / 2)},${y0}H${x0 + w - Math.min(r, w / 2)}Q${x0 + w},${y0} ${x0 + w},${y0 + Math.min(r, h)}V${y0 + h}Z`;
  const g = svg.append("g").selectAll("g").data(cap).join("g");
  g.append("path").attr("d", d => colPath(x(d.dy), y(d.central), bw, y(0) - y(d.central))).style("fill", "var(--s1)");
  g.filter(d => d.dc != null).append("rect")
    .attr("x", d => x(d.dy)).attr("width", bw).attr("y", d => y(d.dc) + 1).attr("height", d => y(0) - y(d.dc) - 1)
    .style("fill", "var(--s2)");
  g.append("line").attr("x1", d => x(d.dy) + bw / 2).attr("x2", d => x(d.dy) + bw / 2)
    .attr("y1", d => y(d.low)).attr("y2", d => y(d.high)).style("stroke", "var(--muted)").style("stroke-width", "1.5px");
  [["low"], ["high"]].forEach(([k]) => g.append("line").attr("x1", d => x(d.dy) + bw / 2 - 5).attr("x2", d => x(d.dy) + bw / 2 + 5)
    .attr("y1", d => y(d[k])).attr("y2", d => y(d[k])).style("stroke", "var(--muted)").style("stroke-width", "1.5px"));
  g.filter(d => ["2024/25", "2027/28"].includes(d.dy)).append("text").attr("class", "lab")
    .attr("x", d => x(d.dy) + bw / 2).attr("y", d => y(d.high) - 8).attr("text-anchor", "middle").text(d => usd(d.central));
  svg.append("line").attr("x1", m.l).attr("x2", W - m.r).attr("y1", y(0)).attr("y2", y(0)).style("stroke", "var(--line)");
  const tip = tooltip(host);
  g.append("rect").attr("x", d => x(d.dy) - x.step() * x.paddingInner() / 2).attr("width", x.step()).attr("y", m.t).attr("height", H - m.t - m.b)
    .style("fill", "transparent")
    .on("pointermove", (e, d) => tip.show(`<b>Delivery year ${d.dy}</b>${row("Cost per home", usd(d.central), css("--s1"))}${row("Range", `${usd(d.low)} to ${usd(d.high)}`)}${row("Data center portion", d.dc != null ? usd(d.dc) : "not published", css("--s2"))}${row("Auction price", "$" + d.price.toFixed(2) + "/MW-day")}`, e))
    .on("pointerleave", () => tip.hide());
}

// Chart 2: PJM event study
function chart2() {
  const host = document.getElementById("c2"); host.innerHTML = "";
  const W = 900, H = 300, m = { t: 14, r: 16, b: 34, l: 48 };
  const data = [...es, { year: 2020, pct: 0, ci_low: 0, ci_high: 0, ref: true }].sort((a, b) => a.year - b.year);
  const svg = d3.select(host).append("svg").attr("viewBox", `0 0 ${W} ${H}`).attr("role", "img")
    .attr("aria-label", "Line chart of the PJM residential price difference vs rest of US by year");
  const x = d3.scaleLinear().domain(d3.extent(data, d => d.year)).range([m.l, W - m.r]);
  const y = d3.scaleLinear().domain([-5, 25]).range([H - m.b, m.t]);
  svg.append("g").selectAll("line").data(y.ticks(6)).join("line")
    .attr("x1", m.l).attr("x2", W - m.r).attr("y1", d => y(d)).attr("y2", d => y(d))
    .style("stroke", d => d === 0 ? "var(--muted)" : "var(--grid)");
  svg.append("g").selectAll("text").data(y.ticks(6)).join("text")
    .attr("x", m.l - 8).attr("y", d => y(d) + 4).attr("text-anchor", "end").text(d => (d > 0 ? "+" : "") + d + "%");
  svg.append("g").selectAll("text").data(data).join("text")
    .attr("x", d => x(d.year)).attr("y", H - 12).attr("text-anchor", "middle").text(d => d.year);
  svg.append("path").datum(data).attr("d", d3.area().x(d => x(d.year)).y0(d => y(d.ci_low)).y1(d => y(d.ci_high)))
    .style("fill", "var(--band)");
  svg.append("path").datum(data).attr("d", d3.line().x(d => x(d.year)).y(d => y(d.pct)))
    .style("fill", "none").style("stroke", "var(--s1)").style("stroke-width", "2px");
  svg.append("g").selectAll("circle").data(data).join("circle")
    .attr("cx", d => x(d.year)).attr("cy", d => y(d.pct)).attr("r", 4)
    .style("fill", d => d.ref ? "var(--surface)" : "var(--s1)").style("stroke", d => d.ref ? "var(--s1)" : "var(--surface)").style("stroke-width", "2px");
  const xa = x(2025 + 5 / 12);
  svg.append("line").attr("x1", xa).attr("x2", xa).attr("y1", m.t).attr("y2", H - m.b).style("stroke", "var(--muted)").style("stroke-dasharray", "3 3");
  svg.append("text").attr("class", "lab").attr("x", xa - 6).attr("y", m.t + 12).attr("text-anchor", "end").text("Capacity price spike reaches bills, June 2025");
  svg.append("text").attr("class", "lab").attr("x", x(2026) - 6).attr("y", y(es26.pct) - 10).attr("text-anchor", "end").text(pct(es26.pct));
  const tip = tooltip(host);
  const cross = svg.append("line").attr("y1", m.t).attr("y2", H - m.b).style("stroke", "var(--muted)").style("opacity", 0);
  svg.append("rect").attr("x", m.l).attr("y", m.t).attr("width", W - m.l - m.r).attr("height", H - m.t - m.b).style("fill", "transparent")
    .on("pointermove", function (e) {
      const [px] = d3.pointer(e, this); const yr = Math.round(x.invert(px)); const d = data.find(v => v.year === yr); if (!d) return;
      cross.attr("x1", x(yr)).attr("x2", x(yr)).style("opacity", 1);
      tip.show(d.ref ? `<b>${yr}</b>${row("Reference year", "0%")}` : `<b>${yr}</b>${row("PJM vs rest of US", pct(d.pct), css("--s1"))}${row("95% CI", `${pct(d.ci_low)} to ${pct(d.ci_high)}`)}`, e);
    })
    .on("pointerleave", () => { tip.hide(); cross.style("opacity", 0); });
}

// Chart 3: case study indices
function chart3() {
  const host = document.getElementById("c3"); host.innerHTML = "";
  const names = ["Baltimore Gas & Electric", "Dominion Energy Virginia", "Texas statewide", "Georgia Power"];
  const tok = ["--s1", "--s2", "--s3", "--s4"];
  document.getElementById("c3legend").innerHTML = names.map((n, i) => `<span><i class="line" style="background:var(${tok[i]})"></i>${n}</span>`).join("");
  const W = 900, H = 320, m = { t: 14, r: 150, b: 34, l: 48 };
  const svg = d3.select(host).append("svg").attr("viewBox", `0 0 ${W} ${H}`).attr("role", "img")
    .attr("aria-label", "Line chart of inflation-adjusted residential price index, 2019 = 100, for four utilities");
  const x = d3.scaleLinear().domain([2019, 2026]).range([m.l, W - m.r]);
  const y = d3.scaleLinear().domain([85, 140]).range([H - m.b, m.t]);
  svg.append("g").selectAll("line").data(y.ticks(6)).join("line")
    .attr("x1", m.l).attr("x2", W - m.r).attr("y1", d => y(d)).attr("y2", d => y(d))
    .style("stroke", d => d === 100 ? "var(--muted)" : "var(--grid)");
  svg.append("g").selectAll("text").data(y.ticks(6)).join("text")
    .attr("x", m.l - 8).attr("y", d => y(d) + 4).attr("text-anchor", "end").text(d => d);
  svg.append("g").selectAll("text").data(d3.range(2019, 2027)).join("text")
    .attr("x", d => x(d)).attr("y", H - 12).attr("text-anchor", "middle").text(d => d === 2026 ? "2026 YTD" : d);
  const line = d3.line().x(d => x(d.year)).y(d => y(d.idx));
  const ends = [];
  names.forEach((n, i) => {
    const s = s3[n], full = s.filter(d => !d.ytd), tail = s.slice(-2);
    svg.append("path").datum(full).attr("d", line).style("fill", "none").style("stroke", `var(${tok[i]})`).style("stroke-width", "2px");
    svg.append("path").datum(tail).attr("d", line).style("fill", "none").style("stroke", `var(${tok[i]})`).style("stroke-width", "2px").style("stroke-dasharray", "4 4");
    const e = s[s.length - 1];
    svg.append("circle").attr("cx", x(e.year)).attr("cy", y(e.idx)).attr("r", 4).style("fill", `var(${tok[i]})`).style("stroke", "var(--surface)").style("stroke-width", "2px");
    ends.push({ n, y: y(e.idx), v: e.idx });
  });
  ends.sort((a, b) => a.y - b.y);
  for (let i = 1; i < ends.length; i++) if (ends[i].y - ends[i - 1].y < 15) ends[i].y = ends[i - 1].y + 15;
  svg.append("g").selectAll("text").data(ends).join("text").attr("class", "lab")
    .attr("x", x(2026) + 10).attr("y", d => d.y + 4).text(d => `${d.n.replace("Baltimore Gas & Electric", "BGE").replace("Dominion Energy Virginia", "Dominion")} ${Math.round(d.v)}`);
  const tip = tooltip(host);
  const cross = svg.append("line").attr("y1", m.t).attr("y2", H - m.b).style("stroke", "var(--muted)").style("opacity", 0);
  svg.append("rect").attr("x", m.l).attr("y", m.t).attr("width", x(2026) - m.l + 6).attr("height", H - m.t - m.b).style("fill", "transparent")
    .on("pointermove", function (e) {
      const [px] = d3.pointer(e, this); const yr = Math.max(2019, Math.min(2026, Math.round(x.invert(px))));
      cross.attr("x1", x(yr)).attr("x2", x(yr)).style("opacity", 1);
      const rows = names.map((n, i) => { const d = s3[n].find(v => v.year === yr); return d ? row(n, `${d.idx.toFixed(1)} · ${d.cents.toFixed(1)}¢`, css(tok[i])) : ""; }).join("");
      tip.show(`<b>${yr === 2026 ? "2026 (Jan–Jul vs 2025)" : yr}</b>${rows}`, e);
    })
    .on("pointerleave", () => { tip.hide(); cross.style("opacity", 0); });
}

function drawAll() { chart1(); chart2(); chart3(); }
drawAll();
matchMedia("(prefers-color-scheme: dark)").addEventListener("change", drawAll);
new MutationObserver(drawAll).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
</script>

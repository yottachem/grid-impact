<title>Data Center Map</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/maplibre-gl/5.24.0/maplibre-gl.css">
<style>
/* Layout: control bar over a full-height zoomable map; legend and notes beneath. Same identity as the public site. */
:root {
  --bg: #f5f7f9; --surface: #ffffff; --fg: #11161d; --muted: #586271; --line: #d8dee6;
  --op: #2a78d6; --uc: #eb6834; --pr: #1baf7a; --cluster: #3a4250;
  --font-display: "Barlow Semi Condensed", "Arial Narrow", Arial, sans-serif;
  --font-body: "Public Sans", "Helvetica Neue", Arial, sans-serif;
  --font-data: "IBM Plex Mono", ui-monospace, Menlo, monospace;
  color-scheme: light;
}
@media (prefers-color-scheme: dark) {
  :root { --bg: #11151a; --surface: #181d23; --fg: #eef1f4; --muted: #9aa5b2; --line: #2b323b;
    --op: #3987e5; --uc: #d95926; --pr: #199e70; --cluster: #c9d1db; color-scheme: dark; }
}
* { box-sizing: border-box; }
header.mh { padding: 14px 20px 10px; display: grid; gap: 6px; border-bottom: 1px solid var(--line); background: var(--surface); }
.eyebrow { font: 500 11px/1 var(--font-data); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
h1 { font: 600 26px/1.05 var(--font-display); margin: 0; }
.controls { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; font-size: 13px; color: var(--muted); }
select { font: 14px var(--font-body); color: var(--fg); background: var(--surface); border: 1px solid var(--line); border-radius: 6px; padding: 6px 8px; }
.controls label { display: inline-flex; align-items: center; gap: 6px; color: var(--fg); cursor: pointer; }
.legend { display: inline-flex; align-items: flex-start; gap: 0; font: 11px/1 var(--font-data); color: var(--muted); margin-left: auto; flex-wrap: wrap; }
.legend span { display: inline-flex; flex-direction: column; align-items: center; gap: 4px; }
.legend i { display: block; width: 46px; height: 10px; }
#map { height: max(460px, calc(100vh - 230px)); }
.maplibregl-popup-content { background: var(--surface); color: var(--fg); border: 1px solid var(--line); border-radius: 6px; padding: 9px 11px; font: 13px/1.4 var(--font-body); box-shadow: 0 6px 20px rgba(0,0,0,.16); }
.maplibregl-popup-tip { display: none; }
.pop b { display: block; font-weight: 600; margin-bottom: 2px; }
.pop .row { display: flex; justify-content: space-between; gap: 14px; font-variant-numeric: tabular-nums; }
.pop .k { color: var(--muted); }
footer.mf { padding: 8px 20px 12px; font-size: 12px; color: var(--muted); background: var(--surface); border-top: 1px solid var(--line); }
footer.mf p { margin: 2px 0; max-width: 120ch; }

footer.mf a { color: inherit; }
optgroup { font-style: normal; color: var(--muted); }
.hint { font-size: 12px; color: var(--muted); }
.dots { display: inline-flex; gap: 10px; align-items: center; font-size: 12px; color: var(--muted); flex-wrap: wrap; }
.dots i { width: 10px; height: 10px; border-radius: 50%; display: inline-block; margin-right: 4px; vertical-align: -1px; }
</style>

<header class="mh">
  <div class="eyebrow">Grid Impact Tracker · map</div>
  <h1>Data centers and what electricity costs nearby</h1>
  <div class="controls">
    <label for="metric">Shade by <select id="metric">
      <optgroup label="Household costs: counties, neighborhoods when zoomed in">
        <option value="burden">Energy burden: annual bill as % of median income</option>
        <option value="bill">Average annual residential bill</option>
        <option value="chg">Bill change since 2018-19, after inflation</option>
        <option value="cap">PJM capacity cost per home, 2026/27</option>
      </optgroup>
      <optgroup label="Data center load: counties">
        <option value="pipe1k">Data center pipeline MW per 1,000 households</option>
        <option value="op1k">Operating data center MW per 1,000 households</option>
      </optgroup>
    </select></label>
    <label for="dc"><input type="checkbox" id="dc" checked> Data center sites</label>
    <span class="dots"><span><i style="background:var(--op)"></i>Operating</span><span><i style="background:var(--uc)"></i>Under construction</span><span><i style="background:var(--pr)"></i>Proposed</span></span>
    <span class="hint" id="hint" aria-live="polite"></span>
    <span class="legend" id="legend" aria-label="Legend"></span>
  </div>
</header>
<div id="map" role="region" aria-label="Zoomable map of census tracts and data center sites"></div>
<footer class="mf">
  <p>Household costs cover all 50 states and DC: counties when zoomed out, census tracts (about 4,000 people each) when zoomed in. Bills and bill changes are utility averages for full-service residential customers (EIA-861), so every tract a utility serves shares them; energy burden varies by tract because income does (Census ACS 2024 5-year). Where the local utility sells no power to homes (most of Texas, some other areas), the state's average full residential bill is used and labeled. Bill change compares two-year averages, 2018-19 vs. the latest two years, after inflation. Capacity cost appears where default supply passes PJM auction prices through. County values are household-weighted averages of their tracts. Sites: merged from FracTracker (non-commercial use), PNNL, OpenStreetMap, PeeringDB; clusters split as you zoom. <a href="methods.html">Methods</a></p>
  <p>Basemap © OpenFreeMap, © OpenMapTiles, data © OpenStreetMap contributors.</p>
</footer>

<script src="https://cdnjs.cloudflare.com/ajax/libs/maplibre-gl/5.24.0/maplibre-gl.js"></script>
<script>
const SITES = __SITES__;
const COUNTIES_URL = "data/counties_geo.json", TRACT_INDEX_URL = "data/tracts/index.json";
const TRACT_ZOOM = 6.5;  // below this, household costs show by county

const css = n => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
const dark = () => matchMedia("(prefers-color-scheme: dark)").matches;
// Sequential blue (light->dark) and diverging blue <-> gray <-> red, from the site's validated palette
const SEQ = ["#cde2fb", "#9ec5f4", "#6da7ec", "#3987e5", "#256abf", "#104281"];
const DIV = ["#256abf", "#86b6ef", "#d8d7d2", "#f0a3a3", "#d03b3b"];
const METRICS = {
  burden: { bins: [0.015, 0.02, 0.03, 0.04, 0.06], colors: SEQ, labels: ["< 1.5%", "1.5–2%", "2–3%", "3–4%", "4–6%", "6%+"], fmt: v => (v * 100).toFixed(1) + "%" },
  bill: { bins: [1600, 1800, 2000, 2200, 2400], colors: SEQ, labels: ["< $1.6k", "1.6–1.8k", "1.8–2.0k", "2.0–2.2k", "2.2–2.4k", "$2.4k+"], fmt: v => "$" + Math.round(v).toLocaleString() },
  chg: { bins: [-0.15, -0.05, 0.05, 0.15], colors: DIV, labels: ["−15% or more", "−15 to −5%", "±5%", "+5 to +15%", "+15% or more"], fmt: v => (v > 0 ? "+" : "") + (v * 100).toFixed(0) + "%" },
  cap: { bins: [200, 240, 280, 320], colors: SEQ.slice(1), labels: ["< $200", "$200–240", "$240–280", "$280–320", "$320+"], fmt: v => "$" + Math.round(v) },
  pipe1k: { bins: [5, 25, 100, 250], colors: SEQ.slice(1), labels: ["< 5", "5–25", "25–100", "100–250", "250+ MW"], fmt: v => v.toFixed(1) + " MW", county: true },
  op1k: { bins: [5, 25, 100, 250], colors: SEQ.slice(1), labels: ["< 5", "5–25", "25–100", "100–250", "250+ MW"], fmt: v => v.toFixed(1) + " MW", county: true },
};
const USA = [[-125, 24.5], [-66.9, 49.5]];

function fillExpr(m) {
  const { bins, colors } = METRICS[m];
  const step = ["step", ["get", m], colors[0]];
  bins.forEach((b, i) => step.push(b, colors[i + 1]));
  // County layers leave zero-MW counties unshaded
  const show = METRICS[m].county ? ["all", ["has", m], [">", ["to-number", ["get", m]], 0]] : ["has", m];
  return ["case", show, step, "rgba(0,0,0,0)"];
}
function legend(m) {
  const { colors, labels } = METRICS[m];
  document.getElementById("legend").innerHTML = labels.map((l, i) => `<span><i style="background:${colors[i]}"></i>${l}</span>`).join("")
    + (m === "cap" ? `<span><i style="background:transparent;outline:1px dashed var(--muted);outline-offset:-1px"></i>not passed through</span>` : "");
}

const sites = { type: "FeatureCollection", features: SITES.filter(s => ["operating", "construction", "proposed"].includes(s.g)).map(s => ({
  type: "Feature", geometry: { type: "Point", coordinates: [s.x, s.y] },
  properties: { g: s.g, mw: s.mw ?? 0, known: s.mw != null ? 1 : 0, n: s.n || "Unnamed site", o: s.o || "", c: s.c || "", s: s.s || "", b: s.b || "" } })) };

const map = new maplibregl.Map({
  container: "map",
  style: dark() ? "https://tiles.openfreemap.org/styles/dark" : "https://tiles.openfreemap.org/styles/positron",
  bounds: USA, fitBoundsOptions: { padding: 20 }, attributionControl: { compact: true },
});
map.addControl(new maplibregl.NavigationControl({ showCompass: false }), "top-right");
map.addControl(new maplibregl.ScaleControl({ unit: "imperial" }), "bottom-left");

map.on("load", () => {
  const firstLabel = map.getStyle().layers.find(l => l.type === "symbol")?.id;
  const tractFC = { type: "FeatureCollection", features: [] };
  map.addSource("tracts", { type: "geojson", data: tractFC });
  map.addSource("counties", { type: "geojson", data: COUNTIES_URL });
  map.addLayer({ id: "counties-fill", type: "fill", source: "counties", maxzoom: TRACT_ZOOM, paint: { "fill-color": fillExpr("burden"), "fill-opacity": 0.7 } }, firstLabel);
  map.addLayer({ id: "counties-line", type: "line", source: "counties", maxzoom: TRACT_ZOOM, paint: { "line-color": dark() ? "#11151a" : "#ffffff", "line-width": 0.3 } }, firstLabel);
  map.addLayer({ id: "tracts-fill", type: "fill", source: "tracts", minzoom: TRACT_ZOOM, paint: { "fill-color": fillExpr("burden"), "fill-opacity": 0.68 } }, firstLabel);
  map.addLayer({ id: "tracts-line", type: "line", source: "tracts", minzoom: TRACT_ZOOM, paint: { "line-color": dark() ? "#11151a" : "#ffffff", "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.1, 11, 0.8] } }, firstLabel);
  map.addLayer({ id: "tracts-hover", type: "line", source: "tracts", minzoom: TRACT_ZOOM, paint: { "line-color": css("--fg"), "line-width": 2 }, filter: ["==", ["get", "id"], ""] });

  map.addSource("sites", { type: "geojson", data: sites, cluster: true, clusterMaxZoom: 9, clusterRadius: 40,
    clusterProperties: { mw: ["+", ["get", "mw"]] } });
  map.addLayer({ id: "clusters", type: "circle", source: "sites", filter: ["has", "point_count"], paint: {
    "circle-color": css("--cluster"), "circle-opacity": 0.85, "circle-stroke-color": css("--surface"), "circle-stroke-width": 1.5,
    "circle-radius": ["interpolate", ["linear"], ["get", "point_count"], 2, 11, 25, 17, 150, 26] } });
  map.addLayer({ id: "cluster-n", type: "symbol", source: "sites", filter: ["has", "point_count"], layout: {
    "text-field": ["get", "point_count_abbreviated"], "text-size": 12, "text-font": ["Noto Sans Bold"] },
    paint: { "text-color": css("--surface") } });
  map.addLayer({ id: "sites", type: "circle", source: "sites", filter: ["!", ["has", "point_count"]], paint: {
    "circle-color": ["match", ["get", "g"], "operating", css("--op"), "construction", css("--uc"), css("--pr")],
    "circle-opacity": ["case", ["==", ["get", "known"], 1], 0.9, 0.5],
    "circle-stroke-color": css("--surface"), "circle-stroke-width": 1.2,
    "circle-radius": ["interpolate", ["linear"], ["zoom"],
      8, ["interpolate", ["linear"], ["sqrt", ["get", "mw"]], 0, 3, 70, 14],
      14, ["interpolate", ["linear"], ["sqrt", ["get", "mw"]], 0, 6, 70, 28]] } });

  const pop = new maplibregl.Popup({ closeButton: false, closeOnClick: false, maxWidth: "300px" });
  const row = (k, v) => v == null || v === "" ? "" : `<div class="row"><span class="k">${k}</span><span>${v}</span></div>`;
  const esc = s => String(s).replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
  const fmtMW = mw => mw >= 1000 ? (mw / 1000).toFixed(1) + " GW" : Math.round(mw) + " MW";
  map.on("mousemove", "tracts-fill", e => {
    if (map.queryRenderedFeatures(e.point, { layers: ["sites", "clusters"] }).length) return;
    const p = e.features[0].properties;
    map.setFilter("tracts-hover", ["==", ["get", "id"], p.id]);
    pop.setLngLat(e.lngLat).setHTML(`<div class="pop"><b>Tract ${p.id.slice(5)}, ${esc(p.county)}, ${p.st}</b>
      ${row("Utility", p.util ? esc(p.util) : "not matched")}
      ${row("Median household income", p.inc ? "$" + Math.round(p.inc).toLocaleString() : "—")}
      ${row(`Avg annual bill (${p.by || "—"})`, p.bill ? "$" + Math.round(p.bill).toLocaleString() + (p.bb === "state" ? " (state average)" : "") : "—")}
      ${row("Energy burden", p.burden != null ? (p.burden * 100).toFixed(1) + "%" : "—")}
      ${row("Bill change since 2019", p.chg != null ? METRICS.chg.fmt(p.chg) : "—")}
      ${row("Capacity cost per home, 2026/27", p.cap != null ? "$" + Math.round(p.cap) + (p.capdc != null ? ` ($${Math.round(p.capdc)} data centers)` : "") : "not passed through")}
      ${row("Data center load in tract", p.dcmw ? fmtMW(p.dcmw) : null)}</div>`).addTo(map);
  });
  map.on("mouseleave", "tracts-fill", () => { pop.remove(); map.setFilter("tracts-hover", ["==", ["get", "id"], ""]); });
  map.on("mousemove", "counties-fill", e => {
    if (map.queryRenderedFeatures(e.point, { layers: ["sites", "clusters"] }).length) return;
    const p = e.features[0].properties;
    pop.setLngLat(e.lngLat).setHTML(`<div class="pop"><b>${esc(p.name || "County " + p.id)}${p.st ? ", " + p.st : ""}</b>
      ${row("Households", p.hh ? Math.round(p.hh).toLocaleString() : "—")}
      ${row("Energy burden (household-weighted)", p.burden != null ? (p.burden * 100).toFixed(1) + "%" : null)}
      ${row("Avg annual bill", p.bill != null ? "$" + Math.round(p.bill).toLocaleString() : null)}
      ${row("Bill change since 2018-19", p.chg != null ? METRICS.chg.fmt(p.chg) : null)}
      ${row("Capacity cost per home, 2026/27", p.cap != null ? "$" + Math.round(p.cap) : null)}
      ${row("Operating data centers", p.op ? fmtMW(p.op) : "none listed")}
      ${row("Pipeline (proposed + construction)", p.pipe ? fmtMW(p.pipe) : "none listed")}
      ${row("Pipeline per 1,000 households", p.pipe1k ? p.pipe1k.toFixed(1) + " MW" : null)}
      ${row("Operating per 1,000 households", p.op1k ? p.op1k.toFixed(1) + " MW" : null)}</div>`).addTo(map);
  });
  map.on("mouseleave", "counties-fill", () => pop.remove());
  map.on("mousemove", "sites", e => {
    const p = e.features[0].properties;
    const label = { operating: "Operating", construction: "Approved or under construction", proposed: "Proposed" }[p.g];
    pop.setLngLat(e.lngLat).setHTML(`<div class="pop"><b>${esc(p.n)}</b>${row("Status", label)}${row("Operator", esc(p.o))}
      ${row("County", esc([p.c, p.s].filter(Boolean).join(", ")))}${row("Power", p.known ? fmtMW(p.mw) + (p.b === "reported" ? " reported" : " estimated") : "no size data")}</div>`).addTo(map);
    map.getCanvas().style.cursor = "pointer";
  });
  map.on("mouseleave", "sites", () => { pop.remove(); map.getCanvas().style.cursor = ""; });
  map.on("click", "clusters", async e => {
    const f = e.features[0];
    const z = await map.getSource("sites").getClusterExpansionZoom(f.properties.cluster_id);
    map.easeTo({ center: f.geometry.coordinates, zoom: z });
  });
  map.on("mousemove", "clusters", e => {
    const p = e.features[0].properties;
    pop.setLngLat(e.lngLat).setHTML(`<div class="pop"><b>${p.point_count} data center sites</b>${row("Estimated power", fmtMW(p.mw))}<div class="row"><span class="k">Click to zoom in</span></div></div>`).addTo(map);
    map.getCanvas().style.cursor = "pointer";
  });
  map.on("mouseleave", "clusters", () => { pop.remove(); map.getCanvas().style.cursor = ""; });

  const metric = document.getElementById("metric");
  const hint = document.getElementById("hint");
  function applyMetric() {
    const m = metric.value, countyOnly = !!METRICS[m].county;
    map.setPaintProperty("counties-fill", "fill-color", fillExpr(m));
    map.setPaintProperty("tracts-fill", "fill-color", fillExpr(m));
    map.setLayerZoomRange("counties-fill", 0, countyOnly ? 24 : TRACT_ZOOM);
    map.setLayerZoomRange("counties-line", 0, countyOnly ? 24 : TRACT_ZOOM);
    for (const id of ["tracts-fill", "tracts-line", "tracts-hover"]) map.setLayoutProperty(id, "visibility", countyOnly ? "none" : "visible");
    legend(m); updateHint(); loadVisibleTracts();
  }
  function updateHint() {
    const countyOnly = !!METRICS[metric.value].county;
    hint.textContent = countyOnly ? "By county" : map.getZoom() < TRACT_ZOOM ? "By county · zoom in for neighborhoods" : "By neighborhood (census tract)";
  }
  // Tracts load one state at a time, only for states in view once zoomed in
  const loaded = new Set();
  let tindex = null;
  async function loadVisibleTracts() {
    if (METRICS[metric.value].county || map.getZoom() < TRACT_ZOOM - 0.5) return;
    if (!tindex) tindex = await fetch(TRACT_INDEX_URL).then(r => r.json()).catch(() => ({}));
    const b = map.getBounds(), W = b.getWest(), S = b.getSouth(), E = b.getEast(), N = b.getNorth();
    const need = Object.entries(tindex).filter(([st, v]) => !loaded.has(st) && v.bbox[0] < E && v.bbox[2] > W && v.bbox[1] < N && v.bbox[3] > S).map(([st]) => st);
    if (!need.length) return;
    need.forEach(st => loaded.add(st));
    hint.textContent = `Loading neighborhoods: ${need.join(", ")}…`;
    const parts = await Promise.all(need.map(st => fetch(`data/tracts/${st}.json`).then(r => r.json()).catch(() => null)));
    parts.forEach((p, i) => { if (p) tractFC.features.push(...p.features); else loaded.delete(need[i]); });
    map.getSource("tracts").setData(tractFC);
    updateHint();
  }
  metric.addEventListener("change", applyMetric);
  map.on("moveend", () => { updateHint(); loadVisibleTracts(); });
  document.getElementById("dc").addEventListener("change", e => {
    for (const id of ["clusters", "cluster-n", "sites"]) map.setLayoutProperty(id, "visibility", e.target.checked ? "visible" : "none");
  });
  applyMetric();
});
</script>
